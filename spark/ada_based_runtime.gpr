project Ada_Based_Runtime_Verification is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";

   package Prove is
      for Proof_Switches ("Ada_Based_Runtime") use ("--level=2");
      for Proof_Switches ("Ada_Based_IR") use ("--level=2");
   end Prove;
end Ada_Based_Runtime_Verification;